#!/usr/bin/env bash
# ==============================================================================
# SentinelAI — Script de déploiement et gestion
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Couleurs
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Charger l'environnement
if [ -f ".env" ]; then
    set -a
    source ".env"
    set +a
elif [ -f ".env.example" ]; then
    cp .env.example .env
    set -a
    source ".env"
    set +a
fi

SERIAL_PORT="${SERIAL_PORT:-/dev/ttyACM0}"
SERIAL_BAUDRATE="${SERIAL_BAUDRATE:-115200}"
MICROROS_WS="${MICROROS_WS:-/home/mahdi/microros_ws}"

mkdir -p logs data/snapshots

function log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

function log_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

function log_warn() {
    echo -e "${YELLOW}[ATTENTION]${NC} $1"
}

function log_error() {
    echo -e "${RED}[ERREUR]${NC} $1"
}

# ------------------------------------------------------------------------------
# 1. Commande : INSTALL
# ------------------------------------------------------------------------------
function do_install() {
    log_info "Démarrage de l'installation de SentinelAI..."

    # 1.1 Fichier d'environnement
    if [ ! -f ".env" ]; then
        log_info "Création de .env à partir de .env.example..."
        cp .env.example .env
    fi

    # 1.2 Paquets système requis
    log_info "Vérification des paquets système..."
    MISSING_PKGS=()
    for pkg in build-essential git curl python3-venv v4l-utils usbutils libopencv-dev; do
        if ! dpkg -s "$pkg" &>/dev/null; then
            MISSING_PKGS+=("$pkg")
        fi
    done

    if [ ${#MISSING_PKGS[@]} -gt 0 ]; then
        log_warn "Paquets système manquants : ${MISSING_PKGS[*]}"
        if sudo -n true 2>/dev/null; then
            echo -e "${YELLOW}Exécution : sudo apt-get update && sudo apt-get install -y ${MISSING_PKGS[*]}${NC}"
            sudo apt-get update && sudo apt-get install -y "${MISSING_PKGS[@]}"
        else
            echo -e "${YELLOW}Pour installer ces paquets système, exécutez manuellement :${NC}"
            echo -e "  sudo apt-get update && sudo apt-get install -y ${MISSING_PKGS[*]}"
        fi
    else
        log_success "Tous les paquets système nécessaires sont installés."
    fi

    # 1.3 Droits utilisateurs et ModemManager
    log_info "Vérification des groupes de l'utilisateur..."
    if ! id -nG "$USER" | grep -qw "dialout"; then
        log_warn "Ajout de l'utilisateur $USER au groupe dialout..."
        if sudo -n true 2>/dev/null; then
            sudo usermod -a -G dialout "$USER"
        else
            echo -e "  sudo usermod -a -G dialout $USER"
        fi
    fi
    if ! id -nG "$USER" | grep -qw "input"; then
        log_warn "Ajout de l'utilisateur $USER au groupe input..."
        if sudo -n true 2>/dev/null; then
            sudo usermod -a -G input "$USER"
        else
            echo -e "  sudo usermod -a -G input $USER"
        fi
    fi

    # ModemManager bloque les ports ttyACM
    if systemctl is-active --quiet ModemManager 2>/dev/null; then
        log_warn "ModemManager est actif (risque de blocage de /dev/ttyACM0)."
        if sudo -n true 2>/dev/null; then
            echo -e "${YELLOW}Exécution : sudo systemctl disable --now ModemManager${NC}"
            sudo systemctl disable --now ModemManager || true
        else
            echo -e "${YELLOW}Pour le désactiver, exécutez :${NC}"
            echo -e "  sudo systemctl disable --now ModemManager"
        fi
    fi

    # Règle udev pour ESP32 et lecteur code-barres
    UDEV_FILE="/etc/udev/rules.d/99-sentinelai.rules"
    if [ ! -f "$UDEV_FILE" ]; then
        if sudo -n true 2>/dev/null; then
            log_info "Installation des règles udev SentinelAI..."
            sudo bash -c "cat > $UDEV_FILE" << 'EOF'
# ESP32-S3 USB JTAG / Serial
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", MODE="0666", GROUP="dialout"
# Lecteur de codes USB HID
SUBSYSTEM=="input", ATTRS{name}=="*Barcode*|*Scanner*|*Reader*|*HID*", MODE="0660", GROUP="input"
EOF
            sudo udevadm control --reload-rules && sudo udevadm trigger || true
        else
            log_warn "Pour installer la règle udev SentinelAI, exécutez :"
            echo -e "  sudo bash -c 'cat > $UDEV_FILE' << 'EOF'\nSUBSYSTEM==\"tty\", ATTRS{idVendor}==\"303a\", MODE=\"0666\", GROUP=\"dialout\"\nSUBSYSTEM==\"input\", ATTRS{name}==\"*Barcode*|*Scanner*|*Reader*|*HID*\", MODE=\"0660\", GROUP=\"input\"\nEOF"
            echo -e "  sudo udevadm control --reload-rules && sudo udevadm trigger"
        fi
    fi

    # 1.4 Dépendances Python dans .venv
    log_info "Vérification de l'environnement virtuel Python (.venv)..."
    if [ ! -d ".venv" ]; then
        python3 -m venv .venv
    fi
    .venv/bin/pip install --upgrade pip
    .venv/bin/pip install fastapi "uvicorn[standard]" evdev pyyaml opencv-python ultralytics platformio qrcode pillow pytest

    # 1.5 Modèle YOLO11n
    if [ ! -f "yolo11n.pt" ]; then
        log_info "Téléchargement du modèle YOLO11n..."
        curl -L -o yolo11n.pt "https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.pt"
    fi

    # 1.6 Agent micro-ROS
    log_info "Vérification de l'agent micro-ROS..."
    AGENT_BIN="$MICROROS_WS/install/micro_ros_agent/lib/micro_ros_agent/micro_ros_agent"
    if [ ! -f "$AGENT_BIN" ]; then
        log_info "Compilation de micro_ros_agent dans $MICROROS_WS..."
        mkdir -p "$MICROROS_WS/src"
        if [ ! -d "$MICROROS_WS/src/micro_ros_setup" ]; then
            git clone -b jazzy https://github.com/micro-ROS/micro_ros_setup.git "$MICROROS_WS/src/micro_ros_setup"
        fi
        (
            set +u
            source /opt/ros/jazzy/setup.bash
            cd "$MICROROS_WS"
            colcon build --packages-select micro_ros_setup
            source install/local_setup.bash
            ros2 run micro_ros_setup create_agent_ws.sh || true
            ros2 run micro_ros_setup build_agent.sh
        )
    fi
    log_success "Agent micro-ROS prêt."

    # 1.7 Initialisation de la base SQLite
    log_info "Initialisation de la base de données SQLite..."
    .venv/bin/python3 scripts/seed_db.py

    # 1.8 Compilation du workspace ROS 2
    log_info "Compilation du workspace ROS 2..."
    (
        set +u
        source /opt/ros/jazzy/setup.bash
        set -u
        cd ros2_ws
        colcon build
    )

    # 1.9 Premier build PlatformIO
    log_info "Compilation initiale du firmware ESP32..."
    (
        cd esp32_fw
        "$SCRIPT_DIR/.venv/bin/pio" run
    )

    log_success "Installation complète terminée avec succès !"
}

# ------------------------------------------------------------------------------
# 2. Commande : CHECK
# ------------------------------------------------------------------------------
function do_check() {
    log_info "Exécution du diagnostic matériel et logiciel..."
    source .venv/bin/activate
    python3 scripts/check_env.py
}

# ------------------------------------------------------------------------------
# 3. Commande : FLASH
# ------------------------------------------------------------------------------
function do_flash() {
    log_info "Compilation et téléversement du firmware ESP32-S3 sur $SERIAL_PORT..."
    if [ ! -e "$SERIAL_PORT" ]; then
        log_error "Port $SERIAL_PORT introuvable. Veuillez brancher l'ESP32-S3."
        exit 1
    fi
    (
        cd esp32_fw
        "$SCRIPT_DIR/.venv/bin/pio" run -t upload --upload-port "$SERIAL_PORT"
    )
    log_success "Téléversement terminé avec succès !"
}

# ------------------------------------------------------------------------------
# 4. Commande : STOP
# ------------------------------------------------------------------------------
function do_stop() {
    log_info "Arrêt des processus SentinelAI..."
    pkill -f "micro_ros_agent" 2>/dev/null || true
    pkill -f "ros2 launch sentinelai" 2>/dev/null || true
    pkill -f "sentinelai.scanner_node" 2>/dev/null || true
    pkill -f "sentinelai.access_node" 2>/dev/null || true
    pkill -f "sentinelai.vision_node" 2>/dev/null || true
    pkill -f "sentinelai.web_bridge" 2>/dev/null || true
    log_success "Tous les processus sont arrêtés."
}

# ------------------------------------------------------------------------------
# 5. Commande par défaut : DEPLOY / RUN
# ------------------------------------------------------------------------------
function do_deploy() {
    log_info "Lancement du système complet SentinelAI..."
    trap do_stop EXIT INT TERM

    # Environnement
    set +u
    source /opt/ros/jazzy/setup.bash
    if [ -f "$MICROROS_WS/install/setup.bash" ]; then
        source "$MICROROS_WS/install/setup.bash"
    fi
    source .venv/bin/activate
    if [ -f "ros2_ws/install/setup.bash" ]; then
        source ros2_ws/install/setup.bash
    fi
    export PYTHONPATH="$SCRIPT_DIR/.venv/lib/python3.12/site-packages${PYTHONPATH:+:$PYTHONPATH}"
    set -u

    # Lancement de l'agent micro-ROS
    AGENT_EXEC="$MICROROS_WS/install/micro_ros_agent/lib/micro_ros_agent/micro_ros_agent"
    if [ -e "$SERIAL_PORT" ] && [ -f "$AGENT_EXEC" ]; then
        log_info "Démarrage de l'agent micro-ROS sur $SERIAL_PORT (115200)..."
        "$AGENT_EXEC" serial --dev "$SERIAL_PORT" -b "$SERIAL_BAUDRATE" > logs/micro_ros_agent.log 2>&1 &
        AGENT_PID=$!

        log_info "Attente du statut ESP32 sur /esp32/status (timeout 20s)..."
        WAIT_COUNT=0
        ESP_FOUND=false
        while [ $WAIT_COUNT -lt 20 ]; do
            if ros2 topic list 2>/dev/null | grep -q "/esp32/status"; then
                ESP_FOUND=true
                log_success "ESP32-S3 connecté et détecté !"
                break
            fi
            sleep 1
            WAIT_COUNT=$((WAIT_COUNT + 1))
        done
        if [ "$ESP_FOUND" = false ]; then
            log_warn "Timeout atteint (20s) : /esp32/status non détecté. Poursuite du démarrage..."
        fi
    else
        log_warn "Port série $SERIAL_PORT absent ou agent indisponible. L'agent micro-ROS n'a pas été lancé."
    fi

    # Lancement du système ROS 2
    log_info "Démarrage des nœuds SentinelAI via ros2 launch..."
    ros2 launch sentinelai sentinel.launch.py
}

# Traitement des arguments
CMD="${1:-deploy}"
case "$CMD" in
    install)
        do_install
        ;;
    check)
        do_check
        ;;
    flash)
        do_flash
        ;;
    stop)
        do_stop
        ;;
    deploy)
        do_deploy
        ;;
    *)
        echo "Usage: $0 {install|check|flash|deploy|stop}"
        exit 1
        ;;
esac
