<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentinelai</name>
  <version>0.1.0</version>
  <description>SentinelAI ROS 2 access control and intrusion system</description>
  <maintainer email="mahdi@example.com">mahdi</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
